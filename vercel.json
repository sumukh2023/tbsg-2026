{
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/admin/:resource",
      "destination": "/api/admin?resource=:resource"
    },
    { "source": "/((?!api/|_vercel/).*)", "destination": "/index.html" }
  ]
}
