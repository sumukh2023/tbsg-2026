# Copy to .env and fill in. All client-exposed vars must be prefixed with VITE_.
VITE_APP_NAME="Webfinity 2026"

# Get Passes + digital pass backend (api/*.ts)
# Server-side only; never expose the service-role key to the browser.
# Create the tables with supabase/schema.sql. See docs/PASS_SYSTEM.md.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Event-day gate verification needs NO variable of its own any more. The
# shared VERIFIER_ACCESS_CODE has been removed: volunteers and administrators
# sign in with their own accounts (supabase/migrations/20260802_volunteer_
# authentication.sql), and sessions are server-side rows keyed by an HttpOnly
# cookie. Delete VERIFIER_ACCESS_CODE from the Vercel project — nothing reads
# it, and a live shared code is exactly what this replaced.

# Live updates realtime (optional, client-side and safe to expose: the anon
# key is limited by Row Level Security to published updates only). Without
# these the site falls back to polling /api/updates once a minute.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Apple / Google Wallet (both optional; buttons stay hidden until the
# signing infrastructure exists — see docs/PASS_SYSTEM.md):
# APPLE_TEAM_ID=
# APPLE_PASS_TYPE_ID=
# APPLE_PASS_CERT_P12_BASE64=
# APPLE_PASS_CERT_PASSWORD=
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_CLASS_SUFFIX=
# GOOGLE_WALLET_SA_EMAIL=
# GOOGLE_WALLET_SA_PRIVATE_KEY_PEM=
