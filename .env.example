# Copy to .env and fill in. All client-exposed vars must be prefixed with VITE_.
VITE_APP_NAME="Webfinity 2026"

# Get Passes backend (api/register.ts)
# Set these in the Vercel project settings (server-side only; never expose the
# service-role key to the browser). Create the table with supabase/schema.sql.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
